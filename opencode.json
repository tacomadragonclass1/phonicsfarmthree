{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["strata", "llamacpp"],
  "model": "strata/qwen3.8-flash-next-iq2_xs-agent",
  "small_model": "strata/qwen3.8-flash-next-iq2_xs-agent",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf ..*": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  }
}
